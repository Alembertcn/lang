# ============================================================
# Lang（品牌 MJ）—— 本地环境配置模板
#
# 使用方式：
#   cp env.example .env
#   然后把各项值填成你自己的（.env 已被 .gitignore 忽略）
#
# 修改 .env 后需要重新构建才会生效。
# ============================================================

# ---------- 千问（阿里云百炼 / DashScope）----------
# 必填：API Key。获取：https://bailian.console.aliyun.com/ → API-KEY 管理
QWEN_API_KEY=

# 文本模型：用于长难句分析 / 核心词汇提取 / AI 摘要
# 常用取值：qwen-plus（性价比）/ qwen-max（最强）/ qwen-turbo（最快）
QWEN_MODEL=qwen-plus

# OpenAI 兼容模式接口地址（默认即可，无需修改）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 发音 ----------
# 词卡声优是原版四档（七海 f002 / 恵太 m001 / 葵 f004 / 直樹 m002），
# 音频在本机 mock，不读下面的千问音色。
QWEN_TTS_MODEL=qwen-tts
QWEN_TTS_VOICE=Lenn

# TTS 接口地址（DashScope 原生模式，默认即可）
QWEN_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ---------- 媒体 mock（运行时音频/配图）----------
# 本地：tools/start_media_mock.sh 后用 http://127.0.0.1:18080
# 远程 NAS：https://static.ailuo.fun/lang （见 ASSETS.md / tools/sync_lang_media_to_nas.sh）
# 也可写在 local.properties：MOCK_MEDIA_BASE=...
# MOCK_MEDIA_BASE=http://127.0.0.1:18080

# ---------- 内容更新（可选）----------
# 文章 / 专栏清单的 GitHub Pages 地址；留空 = 只用内置内容
CONTENT_BASE_URL=

# ---------- 原版账号（可选：仅重新抓取接口数据时需要；环境变量名保持 MOJI_*）----------
# tools/fetch_moji_*.py 从 .env 读取；不抓数据可留空
MOJI_ACCOUNT=
MOJI_PASSWORD=
MOJI_COUNTRY_CODE=86

-- 2 → 3：阅读笔记落本地（对位 readNote-add / readNote-list 与 fav-addManySens / fav-listSens）

CREATE TABLE reading_note (
  object_id TEXT NOT NULL PRIMARY KEY,
  src_type INTEGER NOT NULL,
  src_id TEXT NOT NULL,
  target_type INTEGER NOT NULL,
  target_id TEXT NOT NULL,
  title TEXT NOT NULL,
  excerpt TEXT NOT NULL DEFAULT '',
  trans TEXT NOT NULL DEFAULT '',
  underline TEXT NOT NULL DEFAULT '',
  collected INTEGER NOT NULL DEFAULT 0,
  created_at INTEGER NOT NULL,
  UNIQUE (src_id, src_type, target_type, target_id)
);

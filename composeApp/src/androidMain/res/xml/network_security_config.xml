<?xml version="1.0" encoding="utf-8"?>
<!--
  Allow cleartext HTTP only for the local media mock used by the real-article
  audio path (adb reverse on 127.0.0.1, or the LAN host during development).
  Everything else keeps the platform default (HTTPS only).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.47</domain>
    </domain-config>
</network-security-config>
